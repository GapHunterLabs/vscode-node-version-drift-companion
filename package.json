{
  "name": "node-version-drift-companion",
  "displayName": "Node Version Drift Companion",
  "description": "Flags when .nvmrc/.node-version/package.json engines.node/Dockerfile/CI disagree on the Node.js version. No data leaves your editor.",
  "version": "0.1.1",
  "publisher": "GapHunterLabs",
  "icon": "images/icon.png",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "node",    "nvm",    "version",    "drift"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GapHunterLabs/vscode-node-version-drift-companion.git"
  },
  "bugs": {
    "url": "https://github.com/GapHunterLabs/vscode-node-version-drift-companion/issues"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {},
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "tsc -p ./ && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.2"
  }
}
